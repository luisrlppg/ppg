# PPG ERP — variables para el servidor de PRODUCCIÓN (docker compose --profile full).
#
# Uso:
#   cp .env.production.example .env.production
#   edita los secretos (¡no reutilices los de desarrollo!)
#   ./scripts/deploy.sh update
#
# El stack lee este archivo con `--env-file .env.production` (lo hace deploy.sh).
#
# Imágenes: CI las publica en GHCR (ghcr.io/luisrlppg/ppg-{api,web,tools}) y el
# servidor sólo hace `pull`. Si los paquetes son privados, autentícate una vez:
#   docker login ghcr.io -u <usuario> -p <PAT-con-read:packages>
# Despliega/rollback a un tag concreto: `./scripts/deploy.sh update <sha>`.
PPG_TAG=latest

# --- Base de datos (servicio `postgres` del stack) ---
POSTGRES_USER=ppg
POSTGRES_PASSWORD=cambia-esta-clave-por-una-segura
POSTGRES_DB=ppg
POSTGRES_VERSION=18
# Puerto del host que publica PostgreSQL. Ponlo solo si necesitas acceso externo.
POSTGRES_PORT=5432

# --- Auth del API (secreto largo y aleatorio; NO uses dev-secret-change-me) ---
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=12h

# --- Super admin: autoriza el borrado duro de usuarios (vista Usuarios) ---
SUPER_ADMIN_PASSWORD=cambia-esta-clave-super

# --- Puertos publicados por el stack (la web es la entrada única) ---
WEB_HOST_PORT=8090
API_HOST_PORT=3001

# --- Bootstrap de auth (solo `--profile tools` / instalación sin respaldo) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-clave
ADMIN_NOMBRE=Administrador

# --- Monitor de stock (opcional: se activa el canal que esté completo) ---
# MONITOR_TELEGRAM_TOKEN=
# MONITOR_TELEGRAM_CHAT_ID=
# MONITOR_CALLMEBOT_APIKEY=
# MONITOR_CALLMEBOT_PHONE=
# MONITOR_EMAIL_HOST=smtp.example.com
# MONITOR_EMAIL_PORT=587
# MONITOR_EMAIL_USER=
# MONITOR_EMAIL_PASS=
# MONITOR_EMAIL_FROM=
# MONITOR_EMAIL_TO=alerta@example.com
