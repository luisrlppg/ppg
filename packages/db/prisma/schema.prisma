// PPG ERP — Base de datos central.
// v0 (E0): auth. v1 (E1): catálogos, producto/variantes, precios, ubicaciones, stock.
// v2 (E2): clientes, ventas y fabricación (§4). v3 (E3): producción/reportes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// E0 — Auth
// ---------------------------------------------------------------------------

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  nombre       String
  roleId         Int
  role           Role     @relation(fields: [roleId], references: [id])
  active         Boolean  @default(true)
  separadorMiles String   @default("coma")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([roleId])
}

// ---------------------------------------------------------------------------
// Catálogos
// ---------------------------------------------------------------------------

model Category {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  products Product[]
  createdAt DateTime @default(now())
}

model Packaging {
  id           Int               @id @default(autoincrement())
  nombre       String            @unique
  activo       Boolean           @default(true)
  variantLinks VariantPackaging[]
}

model Attribute {
  id                    Int                    @id @default(autoincrement())
  nombre                String                 @unique
  values                AttributeValue[]
  productLines          ProductAttributeLine[]
  productPassos         ProductPasso[]
  variantAttributes     VariantAttribute[]
  productAttributeValues ProductAttributeValue[]
  createdAt             DateTime               @default(now())
}

model AttributeValue {
  id                    Int                    @id @default(autoincrement())
  attributeId           Int
  attribute             Attribute             @relation(fields: [attributeId], references: [id])
  valor                 String
  variantAttributes     VariantAttribute[]
  productAttributeValues ProductAttributeValue[]
  createdAt             DateTime               @default(now())

  @@unique([attributeId, valor])
  @@index([attributeId])
}

/// Valores permitidos del atributo para un producto (los "ejes" = atributo +
/// subconjunto de valores). Si no hay filas para un (producto, atributo), se
/// asume que todos los valores del atributo son válidos.
model ProductAttributeValue {
  id          Int            @id @default(autoincrement())
  productId   Int
  product     Product        @relation(fields: [productId], references: [id])
  attributeId Int
  attribute   Attribute      @relation(fields: [attributeId], references: [id])
  valueId     Int
  value       AttributeValue @relation(fields: [valueId], references: [id])

  @@unique([productId, attributeId, valueId])
  @@index([productId, attributeId])
}

// ---------------------------------------------------------------------------
// Producto / variantes
// ---------------------------------------------------------------------------

enum Uom {
  pieza
  metro
  kg
}

model Product {
  id              Int                   @id @default(autoincrement())
  nombre          String
  skuBase         String                @unique
  categoryId      Int?
  category        Category?             @relation(fields: [categoryId], references: [id])
  uom             Uom                   @default(pieza)
  basePrice       Decimal               @default(0) // neto, sin IVA
  hasVariants     Boolean               @default(false) // true = familia con grid (combo/perezoso)
  vendible        Boolean               @default(false) // seleccionado para vender en Ventas
  fabricable      Boolean               @default(false) // se puede producir (genera OF)
  comprable       Boolean               @default(false) // se puede adquirir por compra
  imagen          String?
  activo          Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  variants        ProductVariant[]
  attributeLines  ProductAttributeLine[]
  attributeValues ProductAttributeValue[]
  passos          ProductPasso[]
  components      ProductComponent[]    @relation("ComponentParent") // BOM de este producto
  componentOf     ProductComponent[]    @relation("ComponentChild") // dónde se usa este producto
  cost            ProductCost?

  @@index([categoryId])
}

model ProductVariant {
  id               Int                 @id @default(autoincrement())
  productId        Int
  product          Product             @relation(fields: [productId], references: [id])
  nombre           String
  sku              String              @unique
  price            Decimal?            // override si difiere del base (neto, sin IVA)
  stockMin         Decimal             @default(0)
  stockMax         Decimal             @default(0)
  longLead         Boolean             @default(false)
  prioridad        Prioridad           @default(baja) // prioridad manual de fabricación
  imagen           String?
  notas            String?             // anotación interna (ej. medidas del cepillo)
  activo           Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  variantAttributes   VariantAttribute[]
  packagings          VariantPackaging[]
  stockLevels         StockLevel[]
  moves               StockMove[]
  priceChanges        PriceChange[]
  salesLines          SalesOrderLine[]
  reportLines         ProductionReportLine[]

  @@index([productId])
  @@index([prioridad])
}

/// Prioridad manual de fabricación (3 niveles)
enum Prioridad {
  alta
  media
  baja
}

/// Ejes del grid de una familia (combo): product.attribute_lines
model ProductAttributeLine {
  id          Int       @id @default(autoincrement())
  productId   Int
  product     Product   @relation(fields: [productId], references: [id])
  attributeId Int
  attribute   Attribute @relation(fields: [attributeId], references: [id])
  sortOrder   Int       @default(0)

  @@unique([productId, attributeId])
  @@index([productId])
}

/// Pasos de selección guiada para el storefront (E3)
/// productId = producto cuyo storefront se navega (ej. Taparrosca)
/// variantProductId = producto (componente) cuyas variantes activas dan las opciones del paso
/// panel = agrupa pasos que se muestran juntos (ej. característica + color)
model ProductPasso {
  id               Int     @id @default(autoincrement())
  productId        Int
  product          Product @relation(fields: [productId], references: [id])
  variantProductId Int?    // null = same as productId
  sortOrder        Int     @default(0)
  panel            Int     @default(0)
  pregunta         String
  attributeId      Int?
  attribute        Attribute? @relation(fields: [attributeId], references: [id])

  @@index([productId])
}

/// Qué combo es cada variante (variante.perezosa = sin stock real; materializable)
model VariantAttribute {
  id          Int             @id @default(autoincrement())
  variantId   Int
  variant     ProductVariant  @relation(fields: [variantId], references: [id])
  attributeId Int
  attribute   Attribute       @relation(fields: [attributeId], references: [id])
  valueId     Int
  value       AttributeValue  @relation(fields: [valueId], references: [id])

  @@unique([variantId, attributeId])
  @@index([variantId])
  @@index([valueId])
}

/// BOM a nivel producto. componente = products. exacto entra al neteo; consumible (cerda) NO (§5.7)
enum TipoComponente {
  exacto
  consumible
}

model ProductComponent {
  id          Int             @id @default(autoincrement())
  productId   Int             // producto padre (lo que se ensambla)
  product     Product         @relation("ComponentParent", fields: [productId], references: [id])
  componentId Int             // productos que se consumen
  component   Product         @relation("ComponentChild", fields: [componentId], references: [id])
  cantidad    Decimal         @default(1)
  tipo        TipoComponente  @default(exacto)

  @@unique([productId, componentId])
  @@index([productId])
}

/// Piezas que caben en cada empaque de esa variante
model VariantPackaging {
  id          Int         @id @default(autoincrement())
  variantId   Int
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  packagingId Int
  packaging   Packaging   @relation(fields: [packagingId], references: [id])
  cantidad    Decimal     @default(1)

  @@unique([variantId, packagingId])
  @@index([variantId])
}

// ---------------------------------------------------------------------------
// Precios
// ---------------------------------------------------------------------------

enum CampoPrecio {
  base
  variante
}

enum SourcePrecio {
  manual
  api
}

model PriceChange {
  id            Int          @id @default(autoincrement())
  variantId     Int?         // null cuando el cambio es del precio base del producto
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  campo         CampoPrecio
  precioAnterior Decimal
  precioNuevo    Decimal
  source        SourcePrecio @default(manual)
  userId        Int?
  createdAt     DateTime     @default(now())

  @@index([variantId])
}

// ---------------------------------------------------------------------------
// Costos (v1) — costo estándar por producto, capturado a mano (aún no enlazado
// a los precios de venta; ver docs/data-model.md y docs/roadmap.md)
// ---------------------------------------------------------------------------

/// Costo estándar por producto (uno por producto). Materiales 100% manuales;
/// el resto de conceptos es un formulario fijo.
model ProductCost {
  id             Int      @id @default(autoincrement())
  productId      Int      @unique
  product        Product  @relation(fields: [productId], references: [id])
  costoCompra    Decimal? // costo de adquisición (productos comprables)
  horasManoObra  Decimal  @default(0)
  tarifaManoObra Decimal  @default(0)
  horasMaquina   Decimal  @default(0)
  tarifaMaquina  Decimal  @default(0)
  costoMolde     Decimal  @default(0)
  piezasMolde    Decimal  @default(0) // vida útil del molde en piezas
  costoEnsamble  Decimal  @default(0)
  costoEmpaque   Decimal  @default(0)
  notas          String?
  updatedById    Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  materiales ProductCostMaterial[]
}

/// Línea de material capturada a mano para el costo de un producto.
model ProductCostMaterial {
  id            Int         @id @default(autoincrement())
  productCostId Int
  productCost   ProductCost @relation(fields: [productCostId], references: [id], onDelete: Cascade)
  nombre        String
  cantidad      Decimal     @default(1)
  costoUnitario Decimal     @default(0)
  orden         Int         @default(0)

  @@index([productCostId])
}

// ---------------------------------------------------------------------------
// Ubicaciones y stock
// ---------------------------------------------------------------------------

enum TipoUbicacion {
  almacen
  temporal
}

model Location {
  id          Int           @id @default(autoincrement())
  nombre      String        @unique
  tipo        TipoUbicacion @default(almacen)
  activo      Boolean       @default(true)
  stockLevels StockLevel[]
  movesFrom   StockMove[]   @relation("MoveFrom")
  movesTo     StockMove[]   @relation("MoveTo")
  movesAt     StockMove[]   @relation("MoveAt")
  createdAt   DateTime      @default(now())
}

/// La física del stock: único por variante + ubicación.
/// stock_actual(variante) = SUM(stock_levels.qty)
model StockLevel {
  id        Int            @id @default(autoincrement())
  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  locationId Int
  location  Location       @relation(fields: [locationId], references: [id])
  qty       Decimal        @default(0)

  @@unique([variantId, locationId])
  @@index([variantId])
  @@index([locationId])
}

enum MotivoStock {
  apertura
  entrada
  salida
  ajuste
  ensamble
  transferencia
  despacho
  produccion
  consumo
  ubicacion // lote del "Recibo de Producción" → compartimento (§8.3)
}

/// Bitácora de movimientos. qty con signo respecto a la ubicación (lugar por moverse).
/// fromLocationId + toLocationId = transferencia; locationId = movimiento simple en esa ubicación.
model StockMove {
  id             Int          @id @default(autoincrement())
  variantId      Int
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  locationId     Int?         // ubicación afectada en movimientos simples
  location       Location?    @relation("MoveAt", fields: [locationId], references: [id])
  fromLocationId Int?         // transferencia: origen
  fromLocation   Location?    @relation("MoveFrom", fields: [fromLocationId], references: [id])
  toLocationId   Int?         // transferencia: destino
  toLocation     Location?    @relation("MoveTo", fields: [toLocationId], references: [id])
  qty            Decimal
  motivo         MotivoStock
  ref            String?      // referencia de trazabilidad (ej. reporte, orden)
  userId         Int?
  createdAt      DateTime     @default(now())

  @@index([variantId])
  @@index([locationId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// E2 — Clientes, Ventas y Fabricación
// ---------------------------------------------------------------------------

model Partner {
  id        Int      @id @default(autoincrement())
  nombre    String
  empresa   String?
  telefono  String?
  direccion String?
  email     String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders SalesOrder[]

  @@index([nombre])
  @@index([empresa])
}

enum OrigenPedido {
  interno
  web
}

enum EstadoVenta {
  abierta
  despachada
  cancelada
}

enum EstadoEntrega {
  pendiente
  parcial
  entregado
}

model SalesOrder {
  id                  Int            @id @default(autoincrement())
  numero              String         @unique
  partnerId           Int?
  partner             Partner?       @relation(fields: [partnerId], references: [id])
  fecha               DateTime       @default(now())
  fechaEntregaDeseada DateTime?
  estado              EstadoVenta    @default(abierta)
  origen              OrigenPedido   @default(interno)
  paymentMethod       String?        // punto de extensión de pago (E5 / tienda)
  nombreEnvio         String?        // datos de invitado cuando origen = web (§7.7)
  telefonoEnvio       String?
  emailEnvio          String?
  notas               String?
  confirmadaAt        DateTime?      // cuando se aplicó el neteo (§7.5)
  resumen             Json?          // resultado del neteo: { fabricar: [...], comprar: [...] }
  userId              Int?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  lines SalesOrderLine[]

  @@index([partnerId])
  @@index([estado])
  @@index([fecha])
}

model SalesOrderLine {
  id             Int           @id @default(autoincrement())
  orderId        Int
  order          SalesOrder    @relation(fields: [orderId], references: [id])
  variantId      Int
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  cantidad       Decimal
  precioUnitario Decimal
  qtyDelivered   Decimal       @default(0)
  estadoEntrega  EstadoEntrega @default(pendiente)
  configuracion  Json?         // respuestas de las 5 preguntas (atributos seleccionados)

  @@index([orderId])
  @@index([variantId])
}

// ---------------------------------------------------------------------------
// E3 — Producción y Reportes
// ---------------------------------------------------------------------------

enum Turno {
  matutino // 8 h
  vespertino // 7.5 h
  nocturno // 8 h
}

enum SeccionProduccion {
  maquina1
  maquina2
  maquina3
  ensamble
  ensartado
  pegado
  perforado
  fabricacion // líneas internas de reportes generados al concluir una OF hoja
}

enum TipoLineaReporte {
  final // producto terminado → incrementa inventario al aplicarse (§8.1)
  consumo // consumible (ej. cerda en metros) → decrementa stock al aplicarse
}

enum EstadoReporte {
  pendiente // no toca inventario (§8.2)
  aplicado // movimientos ya aplicados
  cancelado
}

model ProductionReport {
  id                  Int                  @id @default(autoincrement())
  numero              String               @unique
  turno               Turno
  fecha               DateTime             @default(now())
  personas            Int                  @default(1)
  horasTrabajadas     Decimal?             // si vacío, se usan las del turno (8 / 7.5 / 8)
  notas               String?
  estado              EstadoReporte        @default(pendiente)
  aplicadoAt          DateTime?
  interno             Boolean              @default(false) // reporte automático histórico (no cuenta en métricas)
  userId              Int?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  lines ProductionReportLine[]

  @@index([estado])
  @@index([fecha])
  @@index([turno])
}

model ProductionReportLine {
  id         Int              @id @default(autoincrement())
  reportId   Int
  report     ProductionReport @relation(fields: [reportId], references: [id])
  variantId  Int
  variant    ProductVariant   @relation(fields: [variantId], references: [id])
  seccion    SeccionProduccion
  tipo       TipoLineaReporte
  ok         Decimal          // conteo registrado (§8.1)
  qtyAplicada Decimal         @default(0) // lo que ya entró/consumió al aplicarse
  qtyUbicada  Decimal         @default(0) // lo ya movido del Recibo a compartimentos

  @@index([reportId])
  @@index([variantId])
}

// ---------------------------------------------------------------------------
// Estado del monitor de stock (solo avisar productos NUEVOS que caen a bajo stock)
// ---------------------------------------------------------------------------

model MonitorState {
  id        Int      @id @default(1) // singleton
  state     Json     // { lastLowStockIds: number[], lastCheck: iso }
  updatedAt DateTime @updatedAt
}

model NotificationEvent {
  id        Int      @id @default(autoincrement())
  type      String   // 'stock' | 'prueba' | ...
  channels  Json     // ['email','telegram','callmebot'] (exitosos)
  subject   String
  ok        Boolean
  createdAt DateTime @default(now())
}