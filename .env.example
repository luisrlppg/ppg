# Copia a .env y ajusta valores (dev).
# Database (local: docker compose up -d postgres)
DATABASE_URL=postgresql://ppg:ppg@localhost:5433/ppg?schema=public
# Auth
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=12h
COOKIE_NAME=ppg_session
# Puertos (dev)
API_PORT=3001
WEB_PORT=3000
# Semilla (solo dev): usuario administrador
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NOMBRE=Administrador