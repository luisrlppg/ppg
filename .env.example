# Copia a .env y ajusta valores (dev).
# Database (mismo puerto para nativo o docker; elige motor con `ppg db <native|docker>`)
DATABASE_URL=postgresql://ppg:ppg@localhost:5432/ppg?schema=public
# Motor de PostgreSQL usado por `ppg`: auto | native | docker (default: auto)
PPG_DB_MODE=auto
# Override opcional de la URL usada cuando PPG_DB_MODE=docker (default: DATABASE_URL)
# DATABASE_URL_DOCKER=postgresql://ppg:ppg@localhost:5432/ppg?schema=public
# Auth
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=12h
COOKIE_NAME=ppg_session
# Puertos (dev)
API_PORT=3001
WEB_PORT=3000
# Semilla (solo dev): usuario administrador
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NOMBRE=Administrador
# Monitor de stock (opcionales: se activa el canal que esté completo)
# MONITOR_TELEGRAM_TOKEN=
# MONITOR_TELEGRAM_CHAT_ID=
# MONITOR_CALLMEBOT_APIKEY=
# MONITOR_CALLMEBOT_PHONE=
# MONITOR_EMAIL_HOST=smtp.example.com
# MONITOR_EMAIL_PORT=587
# MONITOR_EMAIL_USER=
# MONITOR_EMAIL_PASS=
# MONITOR_EMAIL_FROM=
# MONITOR_EMAIL_TO=alerta@example.com